+import os
+import json
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from sophia_node import SophiaEdgeNode, SpeedrunVerifier
+
+class TestSophiaEdgeNodeSpeedrun(unittest.TestCase):
+    def setUp(self):
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.storage_file = os.path.join(self.temp_dir.name, "test_node_state.json")
+        self.node = SophiaEdgeNode(node_id="test-edge-node", storage_path=self.storage_file)
+        self.valid_relic = {
+            "rom_hash": "a1b2c3d4e5f607182930",
+            "frame_count": 180000,
+            "relic_signature": "SIG_VALID_CARTRIDGE_RELIC_100_PERCENT"
+        }
+
+    def tearDown(self):
+        self.temp_dir.cleanup()
+
+    def test_uninstalled_node_prevents_session(self):
+        verifier = SpeedrunVerifier(self.node)
+        with self.assertRaises(RuntimeError):
+            verifier.start_session("Metroid")
+
+    def test_successful_session_lifecycle_and_persistence(self):
+        self.node.install()
+        verifier = SpeedrunVerifier(self.node)
+        session = verifier.start_session("Chrono Trigger")
+        self.assertIsNotNone(session["session_id"])
+        
+        completed = verifier.complete_session(self.valid_relic)
+        self.assertTrue(completed["completed"])
+        self.assertIsNotNone(completed["relic_hash"])
+
+        # Reload node from disk to verify persistence
+        reloaded_node = SophiaEdgeNode(node_id="test-edge-node", storage_path=self.storage_file)
+        stored_session = reloaded_node.get_session(session["session_id"])
+        self.assertTrue(stored_session["completed"])
+        self.assertEqual(stored_session["relic_hash"], completed["relic_hash"])

+    def test_prevent_duplicate_active_sessions(self):
+        self.node.install()
+        verifier = SpeedrunVerifier(self.node)
+        verifier.start_session("Castlevania")
+        with self.assertRaises(RuntimeError):
+            verifier.start_session("Mega Man")

+    def test_prevent_recompleting_session(self):
+        self.node.install()
+        verifier = SpeedrunVerifier(self.node)
+        session = verifier.start_session("Zelda")
+        verifier.complete_session(self.valid_relic)
+        
+        with self.assertRaises(RuntimeError):
+            verifier.complete_session(self.valid_relic, session_id=session["session_id"])

+    def test_invalid_relic_schema_rejected(self):
+        self.node.install()
+        verifier = SpeedrunVerifier(self.node)
+        verifier.start_session("Super Mario World")
+        
+        invalid_relic = {"rom_hash": "12345"} # missing frame_count and relic_signature
+        with self.assertRaises(ValueError):
+            verifier.complete_session(invalid_relic)

+    def test_saturday_window_enforcement(self):
+        self.node.install()
+        verifier = SpeedrunVerifier(self.node)
+        
+        # Monday UTC
+        monday_utc = datetime(2026, 7, 27, 10, 0, 0, tzinfo=timezone.utc)
+        with self.assertRaises(ValueError):
+            verifier.start_session("Sonic", enforce_saturday=True, override_utc_now=monday_utc)
+            
+        # Saturday UTC
+        saturday_utc = datetime(2026, 8, 1, 10, 0, 0, tzinfo=timezone.utc)
+        session = verifier.start_session("Sonic", enforce_saturday=True, override_utc_now=saturday_utc)
+        self.assertEqual(session["game_title"], "Sonic")

+if __name__ == "__main__":
+    unittest.main()
