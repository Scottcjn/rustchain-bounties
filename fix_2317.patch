+class SpeedrunVerifier:
+    """
+    Verifies Saturday Morning Speedrun / One-Credit Club bounty submissions on sophia-edge-node.
+    """
+    MAX_PAYLOAD_SIZE_BYTES = 1_048_576  # 1MB max payload size constraint
+
+    def __init__(self, node: SophiaEdgeNode):
+        if not isinstance(node, SophiaEdgeNode):
+            raise TypeError("node must be a valid SophiaEdgeNode instance.")
+        self.node = node
+        self._active_session_id = None

+    def start_session(
+        self,
+        game_title: str,
+        enforce_saturday: bool = False,
+        override_utc_now: datetime = None
+    ) -> dict:
+        """
+        Starts a cold-boot speedrun session.
+        """
+        if not self.node.is_installed():
+            raise RuntimeError("sophia-edge-node must be installed before starting a speedrun session.")
+
+        if self._active_session_id is not None:
+            active = self.node.get_session(self._active_session_id)
+            if active and not active.get("completed"):
+                raise RuntimeError(f"An active session '{self._active_session_id}' is already in progress.")

+        if not isinstance(game_title, str) or not game_title.strip():
+            raise ValueError("game_title must be a non-empty string.")
+        if len(game_title) > 256:
+            raise ValueError("game_title exceeds maximum allowed length (256 chars).")
+
+        now_utc = override_utc_now or datetime.now(timezone.utc)
+        
+        if enforce_saturday and now_utc.weekday() != 5:  # 5 corresponds to Saturday
+            raise ValueError(f"Session start rejected: Saturday Morning Speedrun must be started on Saturday (UTC). Current day index: {now_utc.weekday()}")
+
+        session_id = hashlib.sha256(f"{self.node.node_id}:{game_title}:{now_utc.isoformat()}".encode('utf-8')).hexdigest()[:16]
+        
+        session_data = {
+            "session_id": session_id,
+            "game_title": game_title.strip(),
+            "start_time_iso": now_utc.isoformat(),
+            "start_monotonic": time.monotonic(),
+            "completed": False,
+            "relic_hash": None,
+            "elapsed_hours": None
+        }
+        
+        self.node.record_session(session_id, session_data)
+        self._active_session_id = session_id
+        return session_data

+    def complete_session(
+        self,
+        cartridge_relic_data: dict,
+        max_duration_hours: float = 12.0,
+        session_id: str = None
+    ) -> dict:
+        """
+        Completes an active session and verifies the Cartridge Relic payload.
+        """
+        target_session_id = session_id or self._active_session_id
+        if not target_session_id:
+            raise ValueError("No active or specified speedrun session found to complete.")

+        session = self.node.get_session(target_session_id)
+        if not session:
+            raise ValueError(f"Session ID '{target_session_id}' not found.")

+        if session.get("completed"):
+            raise RuntimeError(f"Session '{target_session_id}' is already completed and sealed.")

+        if not isinstance(cartridge_relic_data, dict):
+            raise TypeError("cartridge_relic_data must be a non-empty dictionary containing relic proof attributes.")

+        # Validate required proof fields
+        required_fields = {"rom_hash", "frame_count", "relic_signature"}
+        missing = required_fields - set(cartridge_relic_data.keys())
+        if missing:
+            raise ValueError(f"Cartridge Relic proof is missing required schema fields: {missing}")

+        # Payload size validation
+        serialized_relic = json.dumps(cartridge_relic_data)
+        if len(serialized_relic.encode('utf-8')) > self.MAX_PAYLOAD_SIZE_BYTES:
+            raise ValueError(f"Cartridge Relic payload exceeds max size limit of {self.MAX_PAYLOAD_SIZE_BYTES} bytes.")

+        if max_duration_hours <= 0:
+            raise ValueError("max_duration_hours must be a positive non-zero value.")

+        # Monotonic time check prevents clock tampering
+        start_mono = session.get("start_monotonic")
+        current_mono = time.monotonic()
+        elapsed_seconds = current_mono - start_mono
+        elapsed_hours = elapsed_seconds / 3600.0

+        if elapsed_hours > max_duration_hours:
+            raise ValueError(
+                f"Session exceeded single-sitting time limit. Elapsed: {elapsed_hours:.4f} hrs, Max: {max_duration_hours} hrs."
+            )

+        # Cryptographic proof verification hash
+        proof_payload = (
+            f"NODE:{self.node.node_id}|"
+            f"SESSION:{session['session_id']}|"
+            f"GAME:{session['game_title']}|"
+            f"ROM:{cartridge_relic_data['rom_hash']}|"
+            f"FRAMES:{cartridge_relic_data['frame_count']}|"
+            f"SIG:{cartridge_relic_data['relic_signature']}"
+        )
+        relic_hash = hashlib.sha256(proof_payload.encode('utf-8')).hexdigest()

+        # Seal session
+        session["completed"] = True
+        session["relic_hash"] = relic_hash
+        session["elapsed_hours"] = round(elapsed_hours, 6)
+        session["relic_proof"] = cartridge_relic_data

+        self.node.record_session(target_session_id, session)
+        if self._active_session_id == target_session_id:
+            self._active_session_id = None

+        return session
